# Normalize line endings: store text as LF in the repo, check out native.
* text=auto

# Always LF for these regardless of platform.
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.txt text eol=lf
*.md  text eol=lf
CMakeLists.txt text eol=lf
